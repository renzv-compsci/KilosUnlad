# Dependencies
node_modules/
.pnp
.pnp.js

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.pytest_cache/

# Production Builds & Bundles
dist/
dist-ssr/
build/
*.egg-info/

# Environment Files (Keep secrets out of Git!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Database Storage & Local Docker Volumes
mongo-data/
docker/data/

# Raw Large Datasets (Keep heavy raw CSVs local)
data-pipeline/data/raw/*.csv
data-pipeline/seeds/*.parquet
data-pipeline/data/intermediate
data-pipeline/exports 
data-pipeline/partitions

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Specific
.DS_Store
Thumbs.db

# IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
# Field evidence (beneficiary photos) written by the upload adapter: never commit
server/uploads/

# DAT-05 baseline snapshots (regenerated by snapshot_baseline.sh)
data-pipeline/snapshots/
deploy/*.archive.gz

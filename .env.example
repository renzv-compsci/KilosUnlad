# ==============================================================================
# KILOSUNLAD GLOBAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GATEWAY NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_PORT=3000
GATEWAY_PORT=80

# Allowed origins for Express CORS middleware (comma-separated):
CORS_ORIGIN=http://localhost:3000,http://localhost,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB 6.0)
# ------------------------------------------------------------------------------
# Root credentials used ONLY by Docker to initialize the database:
MONGO_INITDB_ROOT_USERNAME=admin_user
MONGO_INITDB_ROOT_PASSWORD=RootAdminSecret2026!
MONGO_INITDB_DATABASE=kilosunlad

# Application credentials (created in init-mongo.js with restricted audit privileges):
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=AppUserPassword2026!

# Application Connection String (Node.js connects as app_user, NOT root):
MONGO_URI=mongodb://app_user:AppUserPassword2026!@db:27017/kilosunlad?authSource=kilosunlad

# ------------------------------------------------------------------------------
# 3. BACKEND AUTHENTICATION & SECURITY (Node.js & Express)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_kilosunlad_jwt_key_2026_dswd_audit
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_2026_dswd_audit
REFRESH_TOKEN_EXPIRES_IN=7d

# Statutory Appeal Clock (Can be set to 15 days in prod, or minutes for testing):
APPEAL_WINDOW_DAYS=15

# ------------------------------------------------------------------------------
# 4. EVIDENCE PHOTO STORAGE (Local Volume / Disk)
# ------------------------------------------------------------------------------
# Absolute path inside the Docker container where photos will be stored:
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ------------------------------------------------------------------------------
# 5. INTERNAL MICROSERVICE NETWORKING
# ------------------------------------------------------------------------------
# Internal Docker bridge DNS pointing to Python FastAPI:
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (Vite React)
# ------------------------------------------------------------------------------
# In development, the browser connects via the gateway (port 80) or directly to port 5000:
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME="KilosUnlad MIS"
VITE_ENABLE_OFFLINE_SYNC=true

# ------------------------------------------------------------------------------
# 7. ML & ANALYTICS MICROSERVICE (Python / FastAPI)
# ------------------------------------------------------------------------------
ML_ENV=development
MODEL_ARTIFACT_PATH=/app/artifacts/lightgbm_swdi_v1.joblib
LOG_LEVEL=info
    "water": "external water_utility.avg_monthly_cu_m > 25",
    "telecom": "external telecom_registry.contract_type starts with POSTPAID",
    "vehicle": "any PASSENGER_4W vehicle that is not a commercial franchise and, where recorded, is owned (outright or encumbered) by a household member"
  },
  "response": {
